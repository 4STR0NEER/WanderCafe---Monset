# Copy to .env.local for `npm run dev`, and add the same keys in Vercel > Settings > Environment Variables.
# Never commit the real file.

# PayMongo dashboard > Developers > API keys. Use sk_test_ until the owner's account is activated.
PAYMONGO_SECRET_KEY=
# The secret key PayMongo gives you when you register the webhook (README > Go live).
PAYMONGO_WEBHOOK_SECRET=

# Supabase > Project Settings > API: the project URL and the service_role key (server only, never in the browser).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Password for the /staff screen. Use a long random one.
STAFF_PASSWORD=

# Optional: the public site URL PayMongo sends guests back to. Defaults to the current host.
SITE_URL=
